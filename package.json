{
  "name": "@cbs-consulting/generator-btp",
  "version": "1.4.0",
  "type": "module",
  "description": "cbs BTP Generator - Yeoman generator for bootstrapping SAP CAP and UI5 projects with TypeScript, ESLint, dev containers and CI/CD best practices",
  "keywords": [
    "yeoman-generator",
    "sap",
    "btp",
    "cap",
    "ui5",
    "devcontainer",
    "typescript",
    "eslint"
  ],
  "homepage": "https://github.com/cbs-consulting/generator-btp#readme",
  "bugs": "https://github.com/cbs-consulting/generator-btp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbs-consulting/generator-btp.git"
  },
  "license": "Apache-2.0",
  "main": "generators/app/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:devcontainer": "bash scripts/test-in-devcontainer.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "hooks": "git config core.hooksPath .githooks"
  },
  "files": [
    "generators",
    "utils",
    "!**/__tests__",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chalk": "5.6.2",
    "comment-json": "4.5.1",
    "glob": "13.0.1",
    "lodash.mergewith": "4.6.2",
    "lodash.union": "4.6.0",
    "yeoman-generator": "7.5.1",
    "yosay": "3.0.0"
  },
  "devDependencies": {
    "@devcontainers/cli": "0.89.0",
    "@eslint/js": "10.0.1",
    "@sap/cds-dk": "9.9.2",
    "@yeoman/adapter": "4.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "vitest": "5.0.5",
    "yeoman-assert": "3.1.1",
    "yeoman-environment": "5.1.3",
    "yeoman-test": "11.8.2"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --config eslint.config.mjs --fix --no-warn-ignored",
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
